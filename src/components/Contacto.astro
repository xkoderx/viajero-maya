---
// Contacto: datos de la agencia + formulario mailto (patrón de Inkontruoo).
import { CONTACTO } from "../data/tours";
---

<section id="contacto" class="bg-sand py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <div class="mx-auto mb-12 max-w-2xl text-center" data-aos="fade-up">
      <p class="text-sm font-bold uppercase tracking-widest text-accent">Para más información</p>
      <h2 class="mt-2 font-display text-4xl font-bold text-ink md:text-5xl">Contacto</h2>
      <p class="mt-4 text-lg text-smoke">
        Escríbenos a
        <a href={`mailto:${CONTACTO.email}`} class="font-bold text-brand-dark hover:underline">
          {CONTACTO.email}
        </a>
        o llena el formulario.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-5">
      <div class="space-y-4 lg:col-span-2" data-aos="fade-right">
        <a
          href={`mailto:${CONTACTO.email}`}
          class="block rounded-2xl bg-white p-6 shadow-md transition-shadow hover:shadow-lg"
        >
          <p class="text-sm font-bold uppercase tracking-widest text-brand-dark">Correo</p>
          <p class="mt-1 break-all text-lg font-bold text-ink">{CONTACTO.email}</p>
        </a>
        <a
          href={`tel:${CONTACTO.oficina.replace(/-/g, "")}`}
          class="block rounded-2xl bg-white p-6 shadow-md transition-shadow hover:shadow-lg"
        >
          <p class="text-sm font-bold uppercase tracking-widest text-brand-dark">Oficina</p>
          <p class="mt-1 text-lg font-bold text-ink">{CONTACTO.oficina}</p>
        </a>
        <a
          href={`tel:${CONTACTO.movil.replace(/-/g, "")}`}
          class="block rounded-2xl bg-white p-6 shadow-md transition-shadow hover:shadow-lg"
        >
          <p class="text-sm font-bold uppercase tracking-widest text-brand-dark">Móvil</p>
          <p class="mt-1 text-lg font-bold text-ink">{CONTACTO.movil}</p>
        </a>
        <a
          href={`https://${CONTACTO.web}`}
          class="block rounded-2xl bg-white p-6 shadow-md transition-shadow hover:shadow-lg"
        >
          <p class="text-sm font-bold uppercase tracking-widest text-brand-dark">Web</p>
          <p class="mt-1 text-lg font-bold text-ink">{CONTACTO.web}</p>
        </a>
      </div>

      <form
        action={`mailto:${CONTACTO.email}`}
        method="POST"
        class="rounded-2xl bg-white p-6 shadow-md md:p-8 lg:col-span-3"
        data-aos="fade-left"
      >
        <input
          type="text"
          name="nombre"
          placeholder="Tu nombre"
          required
          class="w-full rounded-lg border border-sand-dark bg-sand px-4 py-3 text-ink placeholder:text-smoke focus:outline-none focus:ring-2 focus:ring-brand"
        />
        <input
          type="email"
          name="email"
          placeholder="Tu correo electrónico"
          required
          class="mt-4 w-full rounded-lg border border-sand-dark bg-sand px-4 py-3 text-ink placeholder:text-smoke focus:outline-none focus:ring-2 focus:ring-brand"
        />
        <input
          type="text"
          name="tour"
          placeholder="Tour de interés (Chiapas, Campeche, CDMX, Oaxaca o Veracruz)"
          class="mt-4 w-full rounded-lg border border-sand-dark bg-sand px-4 py-3 text-ink placeholder:text-smoke focus:outline-none focus:ring-2 focus:ring-brand"
        />
        <textarea
          name="mensaje"
          placeholder="Escribe tu mensaje..."
          rows="5"
          required
          class="mt-4 w-full rounded-lg border border-sand-dark bg-sand px-4 py-3 text-ink placeholder:text-smoke focus:outline-none focus:ring-2 focus:ring-brand"
        ></textarea>
        <button
          type="submit"
          class="mt-4 w-full rounded-full bg-accent py-3 font-bold text-white transition-colors hover:bg-accent-dark"
        >
          Enviar mensaje
        </button>
      </form>
    </div>
  </div>
</section>
